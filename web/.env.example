# Copiar a .env.local y llenar con los datos del proyecto Supabase (Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Dominio interno de los usuarios: «frank.motato» entra como frank.motato@<dominio> en Supabase Auth.
# No necesita existir: los usuarios se crean confirmados y nunca reciben correo.
NEXT_PUBLIC_DOMINIO_USUARIOS=usuarios.diegida.local

# Solo servidor: crear usuarios (pantalla Usuarios del admin y npm run crear-usuario). Nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
