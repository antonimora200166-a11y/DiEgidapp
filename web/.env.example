# Copiar a .env.local y llenar con los datos del proyecto Supabase (Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Dominio interno de los usuarios: «frank.motato» entra como frank.motato@<dominio> en Supabase Auth.
# No necesita existir: los usuarios se crean confirmados y nunca reciben correo.
NEXT_PUBLIC_DOMINIO_USUARIOS=usuarios.diegida.local

# Solo para instalar la base (npm run bd:instalar): Supabase → botón «Connect» → «Session pooler».
# Lleva la contraseña de la base: nunca va a Vercel ni al navegador.
DATABASE_URL=postgresql://postgres.xxxxxxxx:CONTRASEÑA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Solo servidor: crear usuarios (pantalla Usuarios del admin y npm run crear-usuario). Nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Solo servidor: lectura de la foto de la factura en la pantalla Recibir (API de Claude, console.anthropic.com
# → API Keys). Sin ella la pantalla funciona igual, pero las líneas se digitan a mano. Nunca en el navegador.
ANTHROPIC_API_KEY=sk-ant-...
